{
  "manifest_version": 2,
  "name": "readly-capture",
  "version": "1.1",
  "description": "Readly DOM capture helper. Captures the owned session DOM for article reading only; no bypass logic.",
  "browser_specific_settings": {
    "gecko": {
      "id": "readly-capture@readly.app"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": ["capture.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
