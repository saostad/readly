<?xml version="1.0" encoding="utf-8"?>
<!-- Active family card: accent-tinted gradient + accent border, 20dp corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/radius_card" />
    <gradient
        android:angle="270"
        android:endColor="@color/surface1"
        android:startColor="#14B4A2F7" />
    <stroke
        android:width="1dp"
        android:color="#8CB4A2F7" />
</shape>
