<?xml version="1.0" encoding="utf-8"?>
<!-- NYT browser fallback: help, Read/Reload controls, status, then the page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nyt_browser_help"
        android:textColor="@color/text"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            style="@style/Btn.Primary"
            android:id="@+id/browserReadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nyt_browser_read" />

        <Button
            style="@style/Btn.Ghost"
            android:id="@+id/browserReloadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/nyt_browser_reload" />
    </LinearLayout>

    <TextView
        android:id="@+id/browserStatus"
        style="@style/Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <WebView
        android:id="@+id/browserWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
