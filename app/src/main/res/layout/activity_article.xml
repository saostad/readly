<?xml version="1.0" encoding="utf-8"?>
<!-- Automatic article engine: status, Reload/Cancel controls, then the page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/article_help"
        android:textColor="@color/text"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            style="@style/Btn.Ghost"
            android:id="@+id/articleCancelButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/article_cancel" />

        <Button
            style="@style/Btn.Ghost"
            android:id="@+id/articleReloadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/article_reload" />
    </LinearLayout>

    <TextView
        android:id="@+id/articleStatus"
        style="@style/Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/articleGeckoView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
