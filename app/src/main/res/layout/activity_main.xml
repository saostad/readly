<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/readerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/logo_background"
                android:gravity="center"
                android:text="R"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/headerTitle"
                style="@style/Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name" />

            <ImageButton
                android:id="@+id/searchButton"
                style="@style/IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/search_desc"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/refreshButton"
                style="@style/IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/feed_refresh_action"
                android:src="@drawable/ic_refresh" />

            <ImageButton
                android:id="@+id/settingsButton"
                style="@style/IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/settings_desc"
                android:src="@drawable/ic_settings"
                android:tint="@color/accent" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/homeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:id="@+id/homeScroll"
                android:fillViewport="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/needVoiceBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/need_voice_banner"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/setupContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/logo_background"
                                android:gravity="center"
                                android:text="R"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/app_name" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/card_background"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/title"
                                style="@style/CardTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/setup_title" />

                            <TextView
                                android:id="@+id/body"
                                style="@style/Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp" />

                            <TextView
                                android:id="@+id/setupEstimate"
                                style="@style/Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp" />

                            <Button
                                style="@style/Btn.Ghost"
                                android:id="@+id/setupSampleButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="@string/play_sample_button" />

                            <TextView
                                style="@style/Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/setup_sample_help" />

                            <Button
                                style="@style/Btn.Primary"
                                android:id="@+id/downloadButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp" />

                            <TextView
                                android:id="@+id/downloadHelp"
                                style="@style/Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/download_help" />

                            <Button
                                style="@style/Btn.Ghost"
                                android:id="@+id/pocketButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:maxLines="2" />

                            <TextView
                                android:id="@+id/pocketHelp"
                                style="@style/Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/persian_only_help" />

                            <Button
                                style="@style/Btn.Ghost"
                                android:id="@+id/chooseVoiceButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/choose_voice_button" />

                            <TextView
                                style="@style/Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/choose_voice_help" />

                            <ProgressBar
                                android:id="@+id/progressBar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="16dp"
                                android:contentDescription="@string/progress_desc"
                                android:max="100"
                                android:progressDrawable="@drawable/seekbar_progress"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/progressLabel"
                                style="@style/Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:visibility="gone" />

                            <Button
                                style="@style/Btn.Ghost"
                                android:id="@+id/cancelButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/cancel_button"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/cancelHelp"
                                style="@style/Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cancel_help"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/errorText"
                                style="@style/Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:textColor="@color/error"
                                android:visibility="gone" />

                            <Button
                                style="@style/Btn.Primary"
                                android:id="@+id/retryButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/try_again"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/retryHelp"
                                style="@style/Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/retry_help"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/readerContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/notifRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/notifNote"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/notif_note" />

                            <Button
                                style="@style/Btn.Ghost"
                                android:id="@+id/allowButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/allow_button" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/noticeCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/card_background"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/noticeText"
                                style="@style/Body"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <ImageButton
                                style="@style/IconButton"
                                android:id="@+id/dismissNotice"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="4dp"
                                android:contentDescription="@string/dismiss_desc"
                                android:src="@drawable/ic_close" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/errorCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/card_background"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/errorMessage"
                                style="@style/Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/error" />

                            <Button
                                style="@style/Btn.Primary"
                                android:id="@+id/openPageButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/nyt_open_page"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/openPageHelp"
                                style="@style/Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/nyt_open_page_help"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/browseHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageButton
                                android:id="@+id/browseBack"
                                style="@style/IconButton"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:contentDescription="@string/back_desc"
                                android:src="@drawable/ic_back" />

                            <TextView
                                android:id="@+id/browseTitle"
                                style="@style/CardTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/browseContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ImageButton
            android:id="@+id/homeFab"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/fab_background"
            android:contentDescription="@string/add_content_desc"
            android:elevation="6dp"
            android:scaleType="center"
            android:src="@drawable/ic_add"
            android:tint="@color/onAccent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/miniBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/card_background"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/miniText"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/miniDetail"
                style="@style/Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/miniBarProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent"
                android:max="100"
                android:progressBackgroundTint="@color/surface3"
                android:progressTint="@color/accent"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/miniToggle"
            style="@style/IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/minibar_toggle_desc"
            android:src="@drawable/ic_pause" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />
    <LinearLayout
        android:id="@+id/tabRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:visibility="gone" />
</LinearLayout>
