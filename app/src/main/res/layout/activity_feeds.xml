<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/IconButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/back_desc"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/auto_sites_title" />

        <Space
            android:layout_width="34dp"
            android:layout_height="34dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="0dp">

            <TextView
                style="@style/Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_sites_help" />

            <EditText
                android:id="@+id/siteUrl"
                style="@style/BoxEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/auto_sites_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/siteName"
                    style="@style/BoxEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/auto_sites_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/addSite"
                    style="@style/Btn.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/auto_sites_add" />
            </LinearLayout>

            <TextView
                android:id="@+id/addError"
                style="@style/Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/error"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/sitesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/auto_sites_limits_title" />

            <CheckBox
                android:id="@+id/playNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/accent"
                android:minHeight="48dp"
                android:text="@string/auto_sites_play_next"
                android:textColor="@color/text"
                android:textSize="@dimen/text_body" />

            <TextView
                style="@style/Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auto_sites_max_label" />

            <EditText
                android:id="@+id/maxArticles"
                style="@style/BoxEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLines="1" />

            <TextView
                style="@style/Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auto_sites_refresh_label" />

            <EditText
                android:id="@+id/refreshMinutes"
                style="@style/BoxEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLines="1" />

            <Button
                android:id="@+id/saveLimits"
                style="@style/Btn.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/auto_sites_save" />

            <TextView
                android:id="@+id/limitsStatus"
                style="@style/Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                style="@style/Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/auto_sites_unknown_sources" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
