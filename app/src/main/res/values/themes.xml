<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-only theme, used in both day and night (there is no values-night
         override). Custom in-layout top bars; no ActionBar. -->
    <style name="ReadlyTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:buttonStyle">@style/Btn</item>
    </style>

    <!-- Full-width bottom-sheet dialog (Sheets.applyFullWidth runs after show()).
         Not floating, no minimum width, no window background of its own:
         asBottomSheet() sets the sheet drawable with its top corners. -->
    <style name="SheetDialog" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@null</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
