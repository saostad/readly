    <string name="pocket_advanced_title">Persian voice (advanced)</string>
    <string name="pocket_max_tokens_label">Longest stretch (tokens)</string>
    <string name="pocket_max_tokens_help">Higher reads longer stretches in one breath. Too high and the voice may skip or repeat words. 8–50, default 50.</string>
    <string name="pocket_min_tokens_label">Shortest stretch (tokens)</string>
    <string name="pocket_min_tokens_help">Shorter pieces are joined to a neighbour when possible. 1 up to the longest stretch, default 8.</string>
    <string name="pocket_g2p_window_label">Pronunciation window (characters)</string>
    <string name="pocket_g2p_window_help">Long sentences are pronounced in windows of this size. Very large windows make more pronunciation mistakes. 40–1000, default 120.</string>
    <string name="pocket_temperature_label">Voice variation</string>
    <string name="pocket_temperature_help">Higher sounds livelier but less stable. 0–1.5, default 0.3.</string>
    <string name="pocket_decode_steps_label">Quality steps</string>
    <string name="pocket_decode_steps_help">More steps can sound cleaner but take longer. 0 uses the voice\'s own value. 0–4, default 0.</string>
    <string name="pocket_eos_threshold_label">End-of-speech sensitivity</string>
    <string name="pocket_eos_threshold_help">Lower ends each piece sooner, higher lets it run longer. −10 to 10, default −2.</string>
    <string name="pocket_frames_after_eos_label">Extra audio after the end</string>
    <string name="pocket_frames_after_eos_help">Keeps this many 80 ms frames after the voice says it is done, for clipped word endings. 0–10, default 0.</string>
